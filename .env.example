# Docker Compose reads this file automatically. Local Node/Vite processes need
# exported variables (or node --env-file=.env server/prod.ts).
OPENAI_API_KEY=
# Defaults for optional cloud photo processing; configurable on the server.
PHOTO_REPAIR_IMAGE_MODEL=gpt-image-2.5-sunburst
PHOTO_REPAIR_VISION_MODEL=gpt-5-mini
# Local runs default to ./data/photo-repair. Docker uses a persistent named volume.
# PHOTO_REPAIR_DIR=/path/to/photo-jobs
